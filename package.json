{
  "name": "stravibe-extension",
  "displayName": "StraVIBE",
  "description": "Report your AI coding usage to the StraVIBE leaderboard — Strava for vibe coders. Works in VS Code, Cursor, and other VS Code-based editors.",
  "version": "0.3.0",
  "publisher": "stravibe",
  "license": "UNLICENSED",
  "author": "Muhammad Hatif Mujahid",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode",
    "cursor",
    "usage",
    "tokens",
    "leaderboard",
    "stravibe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatifmujahid/straVIBE.git"
  },
  "bugs": {
    "url": "https://github.com/hatifmujahid/straVIBE/issues"
  },
  "homepage": "https://stravibe.vercel.app",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stravibe.login",
        "title": "StraVIBE: Sign in / link account"
      },
      {
        "command": "stravibe.syncNow",
        "title": "StraVIBE: Sync usage now"
      },
      {
        "command": "stravibe.logout",
        "title": "StraVIBE: Sign out"
      },
      {
        "command": "stravibe.openLeaderboard",
        "title": "StraVIBE: Open leaderboard"
      },
      {
        "command": "stravibe.showDiagnostics",
        "title": "StraVIBE: Show diagnostics"
      }
    ],
    "configuration": {
      "title": "StraVIBE",
      "properties": {
        "stravibe.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync your editor AI usage to the leaderboard in the background."
        },
        "stravibe.syncIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often (in minutes) to sync usage when auto-sync is enabled."
        },
        "stravibe.handle": {
          "type": "string",
          "default": "",
          "description": "Optional public display name shown on the leaderboard. Leave blank to use your account name."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.4.0"
  }
}
